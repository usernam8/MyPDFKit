{
  "name": "my-pdf-kit",
  "version": "1.0.0",
  "description": "Modern PDF Editor",
  "author": "Your Name",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:server": "python -m PyInstaller --noconfirm --onedir --noconsole --name server --hidden-import win32timezone --hidden-import fontTools.subset --collect-data docx --collect-data pptx server.py",
    "build": "npm run build:server && electron-builder --win"
  },
  "dependencies": {
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mypdfkit.app",
    "productName": "MyPDFKit",
    "directories": { "output": "release" },
    "files": [
      "main.js",
      "index.html",
      "package.json",
      "node_modules/pdfjs-dist/build/pdf.min.js",
      "node_modules/pdfjs-dist/build/pdf.worker.min.js"
    ],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      { "from": "dist/server", "to": "server" }
    ],
    "fileAssociations": [
      { "ext": "pdf", "name": "PDF Document" },
      { "ext": "docx", "name": "Word Document" },
      { "ext": "xlsx", "name": "Excel Document" }
    ]
  }
}
