{
  "name": "my-pdf-kit",
  "version": "1.5.5",
  "description": "Modern PDF Editor",
  "author": "usernam8",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:server": "python -m PyInstaller --noconfirm --onedir --noconsole --name server --hidden-import win32timezone --hidden-import fontTools.subset --collect-submodules winrt --collect-data docx --collect-data pptx --collect-all pyhanko --collect-all pyhanko_certvalidator --collect-all ezdxf --collect-all pillow_heif --hidden-import asn1crypto --hidden-import xlrd --exclude-module win32ui --exclude-module pythonwin --add-binary \"C:/Python315/abi3t-compat/python3t.dll;.\" server.py",
    "build": "npm run build:server && electron-builder --win",
    "release": "npm run build:server && electron-builder --win --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File publish-release.ps1"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mypdfkit.app",
    "productName": "MyPDFKit",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json",
      "node_modules/pdfjs-dist/build/pdf.min.js",
      "node_modules/pdfjs-dist/build/pdf.worker.min.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "MyPDFKit-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "dist/server",
        "to": "server"
      }
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Editor"
      },
      {
        "ext": [
          "docx",
          "doc",
          "rtf",
          "odt"
        ],
        "name": "Document",
        "role": "Viewer"
      },
      {
        "ext": [
          "xlsx",
          "xls",
          "csv",
          "ods"
        ],
        "name": "Spreadsheet",
        "role": "Viewer"
      },
      {
        "ext": [
          "pptx",
          "ppt",
          "odp"
        ],
        "name": "Presentation",
        "role": "Viewer"
      },
      {
        "ext": [
          "xps",
          "oxps",
          "epub"
        ],
        "name": "Document",
        "role": "Viewer"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "usernam8",
        "repo": "MyPDFKit-releases",
        "releaseType": "release"
      }
    ]
  }
}
