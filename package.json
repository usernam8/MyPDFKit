{
  "name": "my-pdf-kit",
  "version": "1.9.4",
  "description": "Modern PDF Editor",
  "author": "usernam8",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:server": "python -m PyInstaller --noconfirm --onedir --noconsole --name server --hidden-import win32timezone --hidden-import fontTools.subset --collect-submodules winrt --collect-data docx --collect-data pptx --collect-all pyhanko --collect-all pyhanko_certvalidator --collect-all ezdxf --collect-all pillow_heif --hidden-import asn1crypto --hidden-import xlrd --collect-submodules anthropic --hidden-import httpx2 --exclude-module win32ui --exclude-module pythonwin --add-binary \"C:/Python315/abi3t-compat/python3t.dll;.\" server.py",
    "build": "npm run build:server && electron-builder --win",
    "release": "npm run build:server && electron-builder --win --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File publish-release.ps1"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mypdfkit.app",
    "productName": "Toast Docs",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "index.html",
      "i18n.js",
      "i18n-langs.js",
      "LICENSE",
      "README.md",
      "package.json",
      "node_modules/pdfjs-dist/build/pdf.min.js",
      "node_modules/pdfjs-dist/build/pdf.worker.min.js",
      "node_modules/pdfjs-dist/standard_fonts/**",
      "node_modules/pdfjs-dist/cmaps/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Toast Docs",
      "uninstallDisplayName": "Toast Docs",
      "artifactName": "Toast-Docs-Lite-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "dist/server",
        "to": "server"
      },
      {
        "from": "vendor/llama",
        "to": "llama"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "usernam8",
        "repo": "MyPDFKit-releases",
        "releaseType": "release"
      }
    ]
  }
}
